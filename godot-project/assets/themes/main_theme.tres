IconButton/styles/hover = SubResource("SBF_icon_hover")
IconButton/styles/pressed = SubResource("SBF_icon_hover")
IconButton/styles/focus = SubResource("SBF_icon_hover")
IconButton/styles/disabled = SubResource("SBF_icon_normal")
